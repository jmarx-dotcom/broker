# --- Marktdaten ---------------------------------------------------------
# Standardanbieter ist yfinance (kein Key nötig).
# Für den Dauerbetrieb: BROKER_PROVIDER=fmp und Key eintragen.
BROKER_PROVIDER=yfinance
# FMP_API_KEY=

# --- Makrodaten ---------------------------------------------------------
# Kostenlos: https://fredaccount.stlouisfed.org/apikeys
# Ohne Key läuft der Makro-Teil im Degraded-Modus (nur neutrale Bewertung).
FRED_API_KEY=

# --- LLM-Kontext --------------------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
BROKER_LLM_MODEL=claude-opus-5
BROKER_LLM_EFFORT=medium

# --- Benachrichtigung ---------------------------------------------------
# Telegram (empfohlen, am einfachsten)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# SMTP (Alternative)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TO=
